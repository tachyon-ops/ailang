; Track 4 Dogfood Kernel: RPC Edge Gateway ("MRNT")
; Formally verified rate-limiter, 128-bit widening fee metering, and bidirectional wire codec.
(import "stdlib/finance")
(import "stdlib/wire")

(type MilliBps u64[0..10000])
(type TokenCount u64[0..1000000])

(struct BucketState
  ((tokens TokenCount)
   (last_ms u64[0..MAX])))

(enum RateDecision
  (Allowed (next BucketState) (fee_charged u64[0..MAX]))
  (Rejected (retry_ms u64[0..MAX]) (reason u64[1..3])))

(enum RpcFrameDecoded
  (RpcOk (flags u64[0..255]) (seq u64[0..4294967295]) (notional u64[0..MAX]) (fee u64[0..MAX]))
  (RpcErr (code u64[1..3])))

(fn refill_tokens
  ((cur_tokens TokenCount)
   (last_ms u64[0..MAX])
   (now_ms u64[0..MAX])
   (rate_per_sec u64[0..100000])
   (cap TokenCount))
  (out TokenCount
    (== out (if (<= now_ms last_ms)
              (min cur_tokens cap)
              (min cap (+ (min cur_tokens cap) (mul_div_u64 (min (- now_ms last_ms) 1000000) rate_per_sec 1000))))))
  (if (<= now_ms last_ms)
    (min cur_tokens cap)
    (let ((dt (min (- now_ms last_ms) 1000000))
          (added (mul_div_u64 dt rate_per_sec 1000))
          (base (min cur_tokens cap)))
      (min cap (+ base added)))))

(fn gateway_charge_and_limit
  ((bucket BucketState)
   (now_ms u64[0..MAX])
   (rate_per_sec u64[0..100000])
   (cap TokenCount)
   (cost TokenCount)
   (notional u64[0..MAX])
   (fee_bps MilliBps))
  RateDecision
  (let ((cur (field bucket tokens))
        (prev_ms (field bucket last_ms))
        (refilled (call refill_tokens cur prev_ms now_ms rate_per_sec cap)))
    (if (>= refilled cost)
      (let ((fee (call mul_bps_ceil_u64 notional fee_bps))
            (next_ms (max now_ms prev_ms))
            (next_bucket (make BucketState (- refilled cost) next_ms)))
        (variant RateDecision Allowed next_bucket fee))
      (let ((wait_ms (if (< now_ms prev_ms) (- prev_ms now_ms) 1)))
        (variant RateDecision Rejected wait_ms 1)))))

(fn rate_decision_fee ((d RateDecision))
  (out u64[0..MAX]
    (== out (match d
              ((Allowed next_b fee) fee)
              ((Rejected retry reason) 0))))
  (match d
    ((Allowed next_b fee) fee)
    ((Rejected retry reason) 0)))

(fn encode_mrnt_rpc_frame
  ((n u64[32..MAX])
   (buf (mut_bytes n))
   (flags u64[0..255])
   (seq u64[0..4294967295])
   (notional u64[0..MAX])
   (fee u64[0..MAX]))
  u64[32..32]
  (let ((w0 (write_byte buf 0 77))
        (w1 (write_byte buf 1 82))
        (w2 (write_byte buf 2 78))
        (w3 (write_byte buf 3 84))
        (wv (write_byte buf 4 1))
        (wf (write_byte buf 5 flags))
        (wl (write_u16_be buf 6 24))
        (ws (write_u32_le buf 8 seq))
        (wr (write_u32_le buf 12 0))
        (wn (write_u64_le buf 16 notional))
        (wfee (write_u64_le buf 24 fee)))
    (+ w0 (+ w1 (+ w2 (+ w3 (+ wv (+ wf (+ wl (+ ws (+ wr (+ wn wfee))))))))))))

(fn decode_mrnt_rpc_frame ((n u64[0..MAX]) (buf (bytes n)))
  RpcFrameDecoded
  (if (< n 32)
    (variant RpcFrameDecoded RpcErr 1)
    (if (== (bytes_eq4 buf 0 77 82 78 84) 0)
      (variant RpcFrameDecoded RpcErr 2)
      (let ((ver (byte_at buf 4)))
        (if (!= ver 1)
          (variant RpcFrameDecoded RpcErr 3)
          (variant RpcFrameDecoded RpcOk
            (byte_at buf 5)
            (read_u32_le buf 8)
            (read_u64_le buf 16)
            (read_u64_le buf 24)))))))
